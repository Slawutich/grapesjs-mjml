{
  "name": "grapesjs-mjml",
  "version": "1.0.8",
  "description": "MJML Componenets integration in GrapesJS",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "v:patch": "npm version patch -m \"Release v%s\"",
    "build": "grapesjs-cli build --patch=false",
    "start": "grapesjs-cli serve",
    "test": "jest --forceExit"
  },
  "files": [
    "/dist",
    "/locale"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GrapesJS/mjml.git"
  },
  "keywords": [
    "grapesjs",
    "plugin",
    "mjml",
    "wysiwyg"
  ],
  "author": "Artur Arseniev",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@types/mjml": "^5.0.0",
    "cheerio": "^1.2.0",
    "mjml-browser": "^5.0.1"
  },
  "babel": {
    "env": {
      "test": {
        "presets": [
          "@babel/preset-env",
          "@babel/preset-typescript"
        ]
      }
    }
  },
  "devDependencies": {
    "@babel/cli": "^7.15.7",
    "@babel/preset-typescript": "^7.16.7",
    "@types/jest": "^30.0.0",
    "@types/mjml-browser": "^5.0.0",
    "@types/node": "^22.15.33",
    "ajv": "^8.18.0",
    "eslint": "^8.23.0",
    "grapesjs": "^0.22.15",
    "grapesjs-cli": "^4.1.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "regenerator-runtime": "^0.14.1",
    "typescript": "^6.0.3",
    "underscore": "^1.13.8",
    "whatwg-fetch": "^3.6.20"
  }
}
